# Community Communications Stack - Environment & Secrets Template
# COPY THIS FILE TO .env AND FILL IN STRONG GENERATED SECRETS.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# Ensure file permissions on .env are set to 0600 (chmod 600 .env).

# -----------------------------------------------------------------------------
# Database Secrets (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=synapse
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=replace_with_a_secure_generated_database_password

# -----------------------------------------------------------------------------
# Matrix Synapse Secrets
# Generate random keys with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# Used for internal signing and sessions
SYNAPSE_SECRET_KEY=replace_with_openssl_rand_hex_32
# Used for admin registration tokens
SYNAPSE_REGISTRATION_SHARED_SECRET=replace_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Backup & Restore Secrets (Restic)
# -----------------------------------------------------------------------------
# Mandatory repository encryption password - DO NOT LOSE THIS PASSWORD
RESTIC_PASSWORD=replace_with_strong_backup_encryption_passphrase

# Optional S3 off-site backup credentials (required if operations.backups.target is 's3')
# S3_ACCESS_KEY=your_s3_access_key
# S3_SECRET_KEY=your_s3_secret_key
# S3_BUCKET_URL=s3:s3.wasabisys.com/your-community-backup-bucket

# -----------------------------------------------------------------------------
# Optional Services Secrets
# -----------------------------------------------------------------------------
# WhatsApp Bridge AppService Token (only needed if services.whatsapp_bridge.enabled is true)
# WHATSAPP_AS_TOKEN=replace_with_openssl_rand_hex_32
# WHATSAPP_HS_TOKEN=replace_with_openssl_rand_hex_32
