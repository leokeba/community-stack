{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommunityStackConfig",
  "description": "Configuration schema for the Community Communications Stack",
  "type": "object",
  "required": [
    "project",
    "domain",
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "name",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$",
          "description": "Project deployment name (identifier)"
        },
        "profile": {
          "type": "string",
          "enum": [
            "starter",
            "community",
            "accessible",
            "resilient"
          ],
          "description": "Deployment profile determining service scope"
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "IANA time zone used for scheduling, e.g. Europe/Paris (default UTC)"
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "base"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
          "description": "Base domain name, e.g. example.org"
        },
        "matrix": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
          "description": "Matrix homeserver domain, e.g. matrix.example.org"
        },
        "web": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
          "description": "Public community web portal domain, e.g. community.example.org"
        }
      }
    },
    "services": {
      "type": "object",
      "required": [
        "matrix",
        "element",
        "announcements"
      ],
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "federation": {
              "type": "boolean",
              "default": false
            },
            "allow_registration": {
              "type": "boolean",
              "default": false
            },
            "database_type": {
              "type": "string",
              "enum": [
                "postgres"
              ],
              "default": "postgres"
            },
            "max_upload_size_mb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          }
        },
        "element": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "announcements": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "channels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "web_feed": {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                },
                "matrix_room": {
                  "type": "object",
                  "required": [
                    "enabled"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "homeserver_url": {
                      "type": "string",
                      "pattern": "^https?://[^/]+/?$"
                    },
                    "room_id": {
                      "type": "string",
                      "pattern": "^![^: ]+:[^: ]+$"
                    },
                    "access_token_env": {
                      "type": "string",
                      "pattern": "^[A-Z_][A-Z0-9_]*$"
                    },
                    "public_announcement_room": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "enabled": {
                            "const": true
                          }
                        },
                        "required": [
                          "enabled"
                        ]
                      },
                      "then": {
                        "required": [
                          "homeserver_url",
                          "room_id",
                          "access_token_env",
                          "public_announcement_room"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "whatsapp_bridge": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "announcements_only",
                "selective_bridge"
              ],
              "default": "none"
            },
            "mapped_rooms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "matrix_room_id",
                  "whatsapp_chat_jid"
                ],
                "additionalProperties": false,
                "properties": {
                  "matrix_room_id": {
                    "type": "string"
                  },
                  "whatsapp_chat_jid": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "default": []
            }
          }
        },
        "signal": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "vikunja": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
              "default": "2.7.1"
            },
            "hostname": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
              "description": "Public hostname; defaults to tasks.<domain.base>"
            },
            "files_path": {
              "type": "string",
              "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$",
              "default": "data/vikunja/files"
            },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "postgres"
                  ],
                  "default": "postgres"
                },
                "data_path": {
                  "type": "string",
                  "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$",
                  "default": "data/vikunja/postgres"
                }
              }
            },
            "allow_registration": {
              "type": "boolean",
              "default": false
            },
            "enable_link_sharing": {
              "type": "boolean",
              "default": false,
              "description": "Vikunja link sharing; enable only after reviewing its permission model"
            },
            "memory_limit": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[MG]$",
              "default": "512M"
            },
            "cpu_limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16,
              "default": 1
            }
          }
        },
        "facilmap": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "version": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "default": "sha256:bcef0c14e23f8670ea21d18a15d4331348bf253550a5acf39b19d067546f629f",
              "description": "Pinned OCI image digest; default is the 2026-10-30 upstream main build"
            },
            "hostname": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}$",
              "description": "Public hostname; defaults to maps.<domain.base>"
            },
            "cache_path": {
              "type": "string",
              "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$",
              "default": "data/facilmap/cache"
            },
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "default": "11.4.12"
                },
                "data_path": {
                  "type": "string",
                  "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+$",
                  "default": "data/facilmap/mariadb"
                },
                "memory_limit": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*[MG]$",
                  "default": "512M"
                },
                "cpu_limit": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 16,
                  "default": 1
                }
              }
            },
            "memory_limit": {
              "type": "string",
              "pattern": "^[1-9][0-9]*[MG]$",
              "default": "512M"
            },
            "cpu_limit": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 16,
              "default": 1
            }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backups": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "enum": [
                "hourly",
                "daily",
                "weekly"
              ],
              "default": "daily"
            },
            "target": {
              "type": "string",
              "enum": [
                "local",
                "s3",
                "sftp"
              ],
              "default": "local"
            },
            "encryption": {
              "type": "string",
              "enum": [
                "none",
                "restic"
              ],
              "default": "none"
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1,
              "default": 14
            },
            "storage_path": {
              "type": "string",
              "default": "./backups"
            }
          }
        },
        "monitoring": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "community": {
      "type": "object",
      "description": "Public identity shown on the /connect page and in offline packages",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the community"
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
          "maxLength": 200,
          "description": "Canonical https address; defaults to https://<domain.web>"
        },
        "logo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.(png|jpe?g|webp)$",
          "description": "Logo file name, kept next to community-stack.yaml or uploaded by an administrator"
        },
        "cover": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\\.(png|jpe?g|webp)$",
          "description": "Cover image file name, kept next to community-stack.yaml or uploaded by an administrator"
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-zA-Z]{2,}$",
              "maxLength": 254
            }
          }
        },
        "emergency_instructions": {
          "type": "string",
          "maxLength": 1000
        },
        "social": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "platform",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "facebook",
                  "instagram",
                  "threads",
                  "x",
                  "tiktok",
                  "youtube",
                  "linkedin",
                  "whatsapp",
                  "telegram",
                  "mastodon",
                  "pixelfed",
                  "bluesky",
                  "discord",
                  "signal",
                  "other"
                ]
              },
              "url": {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
                "maxLength": 200
              },
              "handle": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "independent": {
          "type": "object",
          "additionalProperties": false,
          "description": "Show or hide independent channels. A channel is shown only if it also works.",
          "properties": {
            "website": {
              "type": "boolean"
            },
            "email": {
              "type": "boolean"
            },
            "matrix": {
              "type": "boolean"
            },
            "activitypub": {
              "type": "boolean"
            },
            "rss": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
